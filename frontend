<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Civic Resolve</title>
<style>
  :root {
    --bg: #eef2f0; --surface: #ffffff; --ink: #14231f; --muted: #5b6b66;
    --line: #dbe3df; --brand: #0f5c4d; --brand-ink: #ffffff; --brand-soft: #dff0ea;
    --high: #b3261e; --med: #b76e00; --low: #2e7d4f;
    --high-bg: #fbe4e2; --med-bg: #fdf0d5; --low-bg: #e1f2e7;
    --focus: #1a73e8;
  }
  :root:not([data-theme="light"]) { color-scheme: light dark; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #0e1715; --surface: #16221f; --ink: #e6efec; --muted: #93a6a0;
      --line: #263631; --brand: #3fb59b; --brand-ink: #062119; --brand-soft: #1b3a33;
      --high: #ff8a80; --med: #f2b34a; --low: #6fcf97;
      --high-bg: #3a1f1d; --med-bg: #3a2c12; --low-bg: #173324;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  }
  .wrap { max-width: 1240px; margin: 0 auto; padding: 24px 20px 48px; }
  header { margin-bottom: 20px; }
  h1 { font-size: 24px; margin: 0 0 4px; letter-spacing: -0.01em; }
  h2 { font-size: 17px; margin: 0 0 14px; }
  .subtitle { color: var(--muted); margin: 0; max-width: 60ch; }

  .layout { display: grid; grid-template-columns: minmax(300px, 380px) 1fr; gap: 20px; align-items: start; }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 20px; }
  .form-card { position: sticky; top: 16px; }
  @media (max-width: 860px) { .form-card { position: static; } }

  label, legend { display: block; font-size: 13px; font-weight: 600; margin: 16px 0 6px; padding: 0; }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  input, select, textarea {
    width: 100%; padding: 10px; border: 1px solid var(--line); border-radius: 6px;
    background: var(--bg); color: var(--ink); font: inherit;
  }
  textarea { resize: vertical; min-height: 96px; }
  :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .hint { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); margin-top: 4px; }

  .urgency { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
  .urgency input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .urgency label {
    margin: 0; text-align: center; padding: 8px 0; border: 1px solid var(--line);
    border-radius: 6px; cursor: pointer; font-weight: 600; background: var(--bg);
  }
  .urgency input:checked + label { background: var(--brand); color: var(--brand-ink); border-color: var(--brand); }
  .urgency input:focus-visible + label { outline: 2px solid var(--focus); outline-offset: 2px; }
  .scale { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); margin-top: 4px; }

  .btn {
    width: 100%; margin-top: 20px; padding: 11px 16px; background: var(--brand); color: var(--brand-ink);
    border: 0; border-radius: 6px; font: inherit; font-weight: 600; cursor: pointer;
  }
  .btn:hover:not(:disabled) { filter: brightness(1.08); }
  .btn:disabled { opacity: .6; cursor: progress; }

  #result { margin-top: 14px; font-size: 14px; }
  .msg { padding: 10px 12px; border-radius: 6px; }
  .msg.ok { background: var(--low-bg); color: var(--low); }
  .msg.err { background: var(--high-bg); color: var(--high); }
  .msg.info { background: var(--brand-soft); color: var(--brand); }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 16px; }
  @media (max-width: 520px) { .stats { grid-template-columns: repeat(2, 1fr); } }
  .stat { border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; }
  .stat b { display: block; font-size: 22px; line-height: 1.2; }
  .stat span { font-size: 12px; color: var(--muted); }

  .toolbar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 12px; }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; }
  .chip {
    padding: 5px 12px; border: 1px solid var(--line); border-radius: 999px; background: transparent;
    color: var(--ink); font: inherit; font-size: 13px; cursor: pointer;
  }
  .chip[aria-pressed="true"] { background: var(--brand); color: var(--brand-ink); border-color: var(--brand); }
  .search { flex: 1; min-width: 160px; }
  .search input { padding: 7px 10px; }

  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; min-width: 640px; }
  th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
  tbody tr:last-child td { border-bottom: 0; }
  th { background: var(--bg); font-size: 12px; color: var(--muted); font-weight: 600; white-space: nowrap; }
  td.id { font-variant-numeric: tabular-nums; color: var(--muted); }
  .desc { max-width: 34ch; overflow-wrap: anywhere; }
  .cat { display: block; font-size: 12px; color: var(--muted); text-transform: capitalize; }
  .center { text-align: center; color: var(--muted); padding: 28px 12px; }
  tr.new { animation: flash 2.4s ease-out; }
  @keyframes flash { from { background: var(--brand-soft); } to { background: transparent; } }

  .badge { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 12px; font-weight: 600; white-space: nowrap; }
  .p-high { background: var(--high-bg); color: var(--high); }
  .p-med { background: var(--med-bg); color: var(--med); }
  .p-low { background: var(--low-bg); color: var(--low); }
  .status { font-weight: 600; text-transform: capitalize; white-space: nowrap; }
  .status::before { content: ""; display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; background: currentColor; }
  .status-open { color: var(--med); }
  .status-resolved { color: var(--low); }
  .status-escalated { color: var(--high); }

  .updated { font-size: 12px; color: var(--muted); margin-top: 8px; text-align: right; }
  @media (prefers-reduced-motion: reduce) { tr.new { animation: none; } }

  .map-section { margin-top: 20px; }
  #complaintMap {
    width: 100%;
    height: 460px;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--bg);
  }
  .location-row {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 8px;
  }
  .location-row .btn-secondary {
    width: auto;
    margin-top: 0;
    padding: 9px 12px;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line);
  }
  .location-status {
    font-size: 12px;
    color: var(--muted);
    margin-top: 5px;
  }
  .map-note {
    font-size: 12px;
    color: var(--muted);
    margin: -6px 0 10px;
  }

</style>
</head>
<body>
<div class="wrap">

  <header>
    <h1>Civic Resolve</h1>
    <p class="subtitle">Report a civic problem. It is routed to the right department and tracked until it is resolved.</p>
  </header>

  <div class="layout">

    <!-- Submission form -->
    <section class="card form-card" aria-labelledby="formTitle">
      <h2 id="formTitle">Report a problem</h2>
      <form id="complaintForm" novalidate>
        <label for="category">Category</label>
        <select id="category">
          <option value="water">Water</option>
          <option value="electricity">Electricity</option>
          <option value="road">Road</option>
          <option value="sanitation">Sanitation</option>
          <option value="other">Other</option>
        </select>

        <div id="otherCategoryWrap" hidden>
          <label for="otherCategory">Mention the type of problem</label>
          <input type="text" id="otherCategory" maxlength="100"
                 placeholder="Enter the type of problem">
        </div>

        <fieldset>
          <legend>How urgent is it?</legend>
          <div class="urgency" id="urgency">
            <input type="radio" name="urgency" id="u1" value="1"><label for="u1">1</label>
            <input type="radio" name="urgency" id="u2" value="2"><label for="u2">2</label>
            <input type="radio" name="urgency" id="u3" value="3" checked><label for="u3">3</label>
            <input type="radio" name="urgency" id="u4" value="4"><label for="u4">4</label>
            <input type="radio" name="urgency" id="u5" value="5"><label for="u5">5</label>
          </div>
          <div class="scale"><span>Can wait</span><span>Critical</span></div>
        </fieldset>




        <label for="text" style="margin-top:0">What is the problem?</label>
        <textarea id="text" maxlength="500" required
          placeholder="e.g. Water leaking on Main Street near the market"></textarea>
        <div class="hint"><span id="textError" role="alert"></span><span id="counter">0 / 500</span></div>

        <label for="contactNumber">Contact number</label>
        <input type="tel" id="contactNumber" name="contactNumber" inputmode="numeric"
               autocomplete="tel" maxlength="10" pattern="[0-9]{10}"
               placeholder="e.g. 9876543210" required>
        <div class="hint"><span id="contactError" role="alert"></span><span>10 digits</span></div>

        <label for="attachment">Choose file</label>
        <input type="file" id="attachment" name="attachment"
               accept="image/*,.pdf,.doc,.docx">
        <div class="hint"><span id="fileError" role="alert"></span><span>Optional</span></div>

        <label>Complaint location</label>
        <div class="location-row">
          <button type="button" class="btn btn-secondary" id="getLocationBtn">
            Use my current location
          </button>
        </div>
        <div class="location-status" id="locationStatus">
          Location is optional. You can tag the complaint on the map.
        </div>

        <button type="submit" class="btn" id="submitBtn">Submit complaint</button>
      </form>
      <div id="result" aria-live="polite"></div>
    </section>

    <!-- Dashboard -->
    <section class="card" aria-labelledby="dashTitle">
      <h2 id="dashTitle">Ticket dashboard</h2>

      <div class="stats" id="stats"></div>

      <div class="toolbar">
        <div class="chips" id="chips" role="group" aria-label="Filter by status"></div>
        <div class="search">
          <input type="search" id="search" placeholder="Search tickets" aria-label="Search tickets">
        </div>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>ID</th><th>Complaint</th><th>Priority</th><th>Department</th><th>Status</th><th>Filed</th></tr>
          </thead>
          <tbody id="ticketBody"><tr><td colspan="6" class="center">Loading tickets…</td></tr></tbody>
        </table>
      </div>
      <div class="updated" id="updated" aria-live="off"></div>

      <section class="map-section" aria-labelledby="mapTitle">
        <h2 id="mapTitle">Complaints map</h2>
        <p class="map-note">Geotagged complaints are shown on the map. Click a marker to view the complaint.</p>
        <div id="complaintMap" aria-label="Map showing geotagged complaints"></div>
      </section>
    </section>

  </div>
</div>


<!-- Replace YOUR_GOOGLE_MAPS_API_KEY with your Google Maps JavaScript API key.
     Enable Maps JavaScript API in Google Cloud before deploying. -->
<script src="https://maps.googleapis.com/maps/api/js?key=YOUR_GOOGLE_MAPS_API_KEY&callback=initComplaintMap" async defer></script>

<script>
let complaintMap = null;
let complaintMarkers = [];
let selectedLocation = null;

function initComplaintMap() {
  const defaultCenter = { lat: 11.3410, lng: 77.7172 }; // Erode fallback
  complaintMap = new google.maps.Map(document.getElementById("complaintMap"), {
    center: defaultCenter,
    zoom: 12,
    mapTypeControl: false,
    streetViewControl: false,
    fullscreenControl: true
  });
  renderMapMarkers();
}

function clearMapMarkers() {
  complaintMarkers.forEach(marker => marker.setMap(null));
  complaintMarkers = [];
}

function renderMapMarkers() {
  if (!complaintMap || !window.google?.maps) return;
  clearMapMarkers();
  const geotagged = tickets.filter(t => Number.isFinite(t.lat) && Number.isFinite(t.lng));
  geotagged.forEach(t => {
    const marker = new google.maps.Marker({
      position: { lat: t.lat, lng: t.lng },
      map: complaintMap,
      title: `Complaint #${t.id}`
    });
    const info = new google.maps.InfoWindow({
      content: `<div style="max-width:260px"><b>Complaint #${esc(t.id)}</b><br>${esc(t.text)}<br><small>${esc(t.category)} · ${esc(t.status)} · ${esc(t.department)}</small></div>`
    });
    marker.addListener("click", () => info.open({ map: complaintMap, anchor: marker }));
    complaintMarkers.push(marker);
  });

  if (geotagged.length) {
    const bounds = new google.maps.LatLngBounds();
    geotagged.forEach(t => bounds.extend({ lat: t.lat, lng: t.lng }));
    complaintMap.fitBounds(bounds);
    if (geotagged.length === 1) complaintMap.setZoom(15);
  }
}

const $ = (id) => document.getElementById(id);
const form = $('complaintForm'), textEl = $('text'), resultDiv = $('result');
const submitBtn = $('submitBtn'), ticketBody = $('ticketBody');
const getLocationBtn = $('getLocationBtn'), locationStatus = $('locationStatus');
const contactEl = $('contactNumber'), attachmentEl = $('attachment');
const categoryEl = $('category'), otherCategoryWrap = $('otherCategoryWrap'),
      otherCategoryEl = $('otherCategory');

const STATUSES = ['all', 'open', 'escalated', 'resolved'];
let tickets = [];          // normalized ticket objects
let filter = 'all';
let query = '';
let lastSnapshot = '';
let knownIds = null;       // null until first load, so existing rows don't flash

/* ---------- helpers ---------- */
function esc(v) {          // prevents user-entered text from injecting HTML
  return String(v ?? '').replace(/[&<>"']/g, c => (
    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

async function api(url, options = {}) {
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 10000);
  try {
    const res = await fetch(url, { ...options, signal: ctrl.signal });
    if (!res.ok) throw new Error(`Server responded with ${res.status}`);
    return await res.json();
  } finally { clearTimeout(timer); }
}

function timeAgo(dateStr) {
  const d = new Date(dateStr);
  if (isNaN(d)) return esc(dateStr);
  const secs = Math.round((d - Date.now()) / 1000);
  const rtf = new Intl.RelativeTimeFormat(undefined, { numeric: 'auto' });
  const units = [['day', 86400], ['hour', 3600], ['minute', 60]];
  for (const [unit, s] of units) {
    if (Math.abs(secs) >= s) return `<time datetime="${esc(d.toISOString())}" title="${esc(d.toLocaleString())}">${rtf.format(Math.round(secs / s), unit)}</time>`;
  }
  return `<time datetime="${esc(d.toISOString())}" title="${esc(d.toLocaleString())}">just now</time>`;
}

function priorityBadge(score) {
  score = parseInt(score, 10) || 0;
  if (score >= 15) return `<span class="badge p-high">High (${score})</span>`;
  if (score >= 8)  return `<span class="badge p-med">Medium (${score})</span>`;
  return `<span class="badge p-low">Low (${score})</span>`;
}

function statusClass(s) {
  return s === 'escalated' ? 'status-escalated' : s === 'resolved' ? 'status-resolved' : 'status-open';
}

function showResult(kind, html) { resultDiv.innerHTML = `<div class="msg ${kind}">${html}</div>`; }

/* ---------- form ---------- */
textEl.addEventListener('input', () => {
  $('counter').textContent = `${textEl.value.length} / 500`;
  $('textError').textContent = '';
});
contactEl.addEventListener('input', () => {
  contactEl.value = contactEl.value.replace(/\D/g, '').slice(0, 10);
  $('contactError').textContent = '';
});
attachmentEl.addEventListener('change', () => {
  $('fileError').textContent = '';
});



categoryEl.addEventListener('change', () => {
  const isOther = categoryEl.value === 'other';
  otherCategoryWrap.hidden = !isOther;
  otherCategoryEl.required = isOther;
  if (!isOther) otherCategoryEl.value = '';
});

getLocationBtn.addEventListener('click', () => {
  if (!navigator.geolocation) {
    locationStatus.textContent = 'Geolocation is not supported by this browser.';
    return;
  }

  getLocationBtn.disabled = true;
  getLocationBtn.textContent = 'Getting location…';
  locationStatus.textContent = 'Requesting your location permission…';

  navigator.geolocation.getCurrentPosition(
    (position) => {
      selectedLocation = {
        lat: Number(position.coords.latitude.toFixed(6)),
        lng: Number(position.coords.longitude.toFixed(6))
      };
      locationStatus.textContent =
        `Location tagged: ${selectedLocation.lat}, ${selectedLocation.lng}`;
      getLocationBtn.disabled = false;
      getLocationBtn.textContent = 'Update my location';

      if (complaintMap) {
        complaintMap.setCenter(selectedLocation);
        complaintMap.setZoom(16);
      }
    },
    (error) => {
      const message = error.code === 1
        ? 'Location permission was denied.'
        : 'Could not get your location. Try again.';
      locationStatus.textContent = message;
      getLocationBtn.disabled = false;
      getLocationBtn.textContent = 'Use my current location';
    },
    { enableHighAccuracy: true, timeout: 10000, maximumAge: 30000 }
  );
});

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  const text = textEl.value.trim();
  if (!text) {
    $('textError').textContent = 'Describe the problem before submitting.';
    textEl.focus();
    return;
  }
  const contact = contactEl.value.trim();
  const customCategory = otherCategoryEl.value.trim();

  $('contactError').textContent = '';
  if (categoryEl.value === 'other' && !customCategory) {
    otherCategoryEl.focus();
    return;
  }
  $('fileError').textContent = '';

  if (!/^\d{10}$/.test(contact)) {
    $('contactError').textContent = 'Enter a valid 10-digit contact number.';
    contactEl.focus();
    return;
  }

  const file = attachmentEl.files[0];
  if (file && file.size > 10 * 1024 * 1024) {
    $('fileError').textContent = 'File must be 10 MB or smaller.';
    attachmentEl.focus();
    return;
  }

  const formData = new FormData();
  formData.append('text', text);
  formData.append('category', categoryEl.value);
  formData.append('other_category', categoryEl.value === 'other' ? customCategory : '');
  formData.append('urgency', form.elements.urgency.value);
  formData.append('contact_number', contact);
  formData.append('latitude', selectedLocation?.lat ?? '');
  formData.append('longitude', selectedLocation?.lng ?? '');
  if (file) formData.append('attachment', file);

  submitBtn.disabled = true;
  submitBtn.textContent = 'Submitting…';
  showResult('info', 'Submitting your complaint…');
  try {
    const data = await api('/submit', {
      method: 'POST',
      body: formData
    });
    showResult('ok', `Complaint submitted. Routed to <b>${esc(data.department)}</b> with priority score <b>${esc(data.priority)}</b>.`);
    form.reset();
    otherCategoryWrap.hidden = true;
    otherCategoryEl.required = false;
    $('counter').textContent = '0 / 500';
    $('contactError').textContent = '';
    $('fileError').textContent = '';
    selectedLocation = null;
    locationStatus.textContent = 'Location is optional. You can tag the complaint on the map.';
    loadTickets();
  } catch (err) {
    console.error(err);
    showResult('err', 'Your complaint was not submitted. Check your connection and try again.');
  } finally {
    submitBtn.disabled = false;
    submitBtn.textContent = 'Submit complaint';
  }
});

/* ---------- dashboard ---------- */
function renderChips() {
  const counts = { all: tickets.length };
  STATUSES.slice(1).forEach(s => counts[s] = tickets.filter(t => t.status === s).length);
  $('chips').innerHTML = STATUSES.map(s =>
    `<button type="button" class="chip" data-f="${s}" aria-pressed="${filter === s}">${s[0].toUpperCase() + s.slice(1)} (${counts[s]})</button>`
  ).join('');
  $('stats').innerHTML = [
    ['Total', counts.all], ['Open', counts.open], ['Escalated', counts.escalated], ['Resolved', counts.resolved]
  ].map(([l, n]) => `<div class="stat"><b>${n}</b><span>${l}</span></div>`).join('');
}

function renderTable() {
  const q = query.toLowerCase();
  const rows = tickets.filter(t =>
    (filter === 'all' || t.status === filter) &&
    (!q || [t.id, t.text, t.category, t.department].join(' ').toLowerCase().includes(q))
  );

  if (!tickets.length) {
    ticketBody.innerHTML = '<tr><td colspan="6" class="center">No tickets yet. Submit the first complaint using the form.</td></tr>';
    return;
  }
  if (!rows.length) {
    ticketBody.innerHTML = '<tr><td colspan="6" class="center">No tickets match this filter.</td></tr>';
    return;
  }
  ticketBody.innerHTML = rows.map(t => `
    <tr class="${knownIds && !knownIds.has(t.id) ? 'new' : ''}">
      <td class="id">#${esc(t.id)}</td>
      <td class="desc">${esc(t.text) || '<span class="cat">No description</span>'}<span class="cat">${esc(t.category)}</span></td>
      <td>${priorityBadge(t.priority)}</td>
      <td>${esc(t.department)}</td>
      <td><span class="status ${statusClass(t.status)}">${esc(t.status)}</span></td>
      <td>${timeAgo(t.created)}</td>
    </tr>`).join('');
}

async function loadTickets() {
  try {
    const data = await api('/tickets');
    const snapshot = JSON.stringify(data.tickets);
    // Row layout from the API: [id, text, category, priority, department, status, created, latitude, longitude]
    if (snapshot !== lastSnapshot) {
      lastSnapshot = snapshot;
      tickets = data.tickets.map(t => ({
        id: t[0], text: t[1], category: t[2], priority: t[3],
        department: t[4], status: String(t[5]).toLowerCase(), created: t[6],
        lat: Number(t[7]), lng: Number(t[8])
      })).sort((a, b) => new Date(b.created) - new Date(a.created));
      renderChips();
      renderTable();
      renderMapMarkers();
      knownIds = new Set(tickets.map(t => t.id));
    }
    $('updated').textContent = `Updated ${new Date().toLocaleTimeString()}`;
  } catch (err) {
    console.error(err);
    if (!tickets.length) {
      ticketBody.innerHTML = '<tr><td colspan="6" class="center">Tickets could not be loaded. Retrying automatically.</td></tr>';
    } else {
      $('updated').textContent = 'Connection lost. Showing the last loaded tickets.';
    }
  }
}

$('chips').addEventListener('click', (e) => {
  const btn = e.target.closest('.chip');
  if (!btn) return;
  filter = btn.dataset.f;
  renderChips();
  renderTable();
});
$('search').addEventListener('input', (e) => { query = e.target.value.trim(); renderTable(); });

/* ---------- live updates: poll every 5s, pause while the tab is hidden ---------- */
loadTickets();
let timer = setInterval(loadTickets, 5000);
document.addEventListener('visibilitychange', () => {
  clearInterval(timer);
  if (!document.hidden) { loadTickets(); timer = setInterval(loadTickets, 5000); }
});
</script>
</body>
</html>
