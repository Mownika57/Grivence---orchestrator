                Contact
            </div>

            <div class="detail-value">
                ${escapeHTML(
                    ticket.phone || "Not provided"
                )}
            </div>

        </div>


        <div class="detail">

            <div class="detail-label">
                Location
            </div>

            <div class="detail-value">
                📍 ${escapeHTML(
                    ticket.location
                )}
            </div>

        </div>


        <div class="detail">

            <div class="detail-label">
                Status
            </div>

            <div class="detail-value">

                ${statusBadge(
                    ticket.status
                )}

            </div>

        </div>


        <div class="detail">

            <div class="detail-label">
                Resolution Timeline
            </div>

            <div class="timeline">

                ${ticket.timeline
                .map(
                    item => `

                    <div class="timeline-item">

                        <div class="timeline-dot">
                        </div>

                        <div class="timeline-title">
                            ${escapeHTML(
                                item.title
                            )}
                        </div>

                        <div class="timeline-time">
                            ${formatDate(
                                item.time
                            )}
                        </div>

                    </div>

                    `
                )
                .join("")}

            </div>

        </div>


        <div class="modal-actions">

            <button
                class="btn btn-primary"
                onclick="updateStatus('${ticket.id}','in-progress')">

                🔧 Start Work

            </button>


            <button
                class="btn"
                style="background:#16a34a;color:white"
                onclick="updateStatus('${ticket.id}','resolved')">

                ✓ Resolve

            </button>


            <button
                class="btn"
                style="background:#fee2e2;color:#b91c1c"
                onclick="deleteTicket('${ticket.id}')">

                🗑 Delete

            </button>

        </div>

    `;


    document.getElementById(
        "ticketModal"
    ).style.display =
    "flex";

}


function hideModal(){

    document.getElementById(
        "ticketModal"
    ).style.display =
    "none";

}


function closeModal(event){

    if(
        event.target.id ===
        "ticketModal"
    ){

        hideModal();

    }

}


/* =====================================================
   UPDATE STATUS
===================================================== */

function updateStatus(
    id,
    status
){

    const ticket =
    tickets.find(
        t => t.id === id
    );


    if(!ticket)
        return;


    ticket.status =
    status;


    ticket.timeline.push({

        title:

        status === "in-progress"

        ? "Department started investigation"

        : "Complaint resolved",

        time:
        new Date().toISOString()

    });


    addActivity(

        `${id} status changed to ${status}.`

    );


    saveData();


    hideModal();


    updateEverything();


    showToast(
        `${id} updated successfully.`
    );

}


/* =====================================================
   DELETE
===================================================== */

function deleteTicket(id){

    if(
        !confirm(
            "Delete this complaint?"
        )
    )
        return;


    tickets =
    tickets.filter(
        t => t.id !== id
    );


    addActivity(
        `${id} was deleted.`
    );


    saveData();


    hideModal();


    updateEverything();


    showToast(
        "Complaint deleted."
    );

}


/* =====================================================
   MAP
===================================================== */

function renderMap(){

    const map =
    document.getElementById(
        "complaintMap"
    );


    if(!map)
        return;


    map
    .querySelectorAll(
        ".map-marker"
    )
    .forEach(
        marker =>
        marker.remove()
    );


    tickets.forEach(
        (ticket,index) => {

            const marker =
            document.createElement(
                "div"
            );


            marker.className =
            `map-marker marker-${ticket.priorityName}`;


            const x =
            10 +
            (
                (index * 37) % 80
            );


            const y =
            15 +
            (
                (index * 53) % 70
            );


            marker.style.left =
            x + "%";


            marker.style.top =
            y + "%";


            marker.title =
            `${ticket.id} — ${ticket.location}`;


            marker.onclick =
            () => openTicket(ticket.id);


            map.appendChild(marker);

        }
    );

}


/* =====================================================
   ANALYTICS
===================================================== */

function renderAnalytics(){

    const categories =
    {};

    const departmentCount =
    {};


    tickets.forEach(
        ticket => {

            categories[
                ticket.category
            ] =
            (
                categories[
                    ticket.category
                ] || 0
            ) + 1;


            departmentCount[
                ticket.department
            ] =
            (
                departmentCount[
                    ticket.department
                ] || 0
            ) + 1;

        }
    );


    const maxCategory =
    Math.max(
        1,
        ...Object.values(
            categories
        )
    );


    document.getElementById(
        "categoryAnalytics"
    ).innerHTML =

    Object.entries(categories)
    .map(
        ([category,count]) => `

        <div class="department">

            <div class="department-top">

                <span>
                    ${formatCategory(category)}
                </span>

                <strong>
                    ${count}
                </strong>

            </div>

            <div class="progress">

                <div
                    class="progress-bar"
                    style="width:${
                        count /
                        maxCategory *
                        100
                    }%">
                </div>

            </div>

        </div>

        `
    )
    .join("");


    const maxDepartment =
    Math.max(
        1,
        ...Object.values(
            departmentCount
        )
    );


    document.getElementById(
        "departmentAnalytics"
    ).innerHTML =

    Object.entries(
        departmentCount
    )
    .map(
        ([department,count]) => `

        <div class="department">

            <div class="department-top">

                <span>
                    ${department}
                </span>

                <strong>
                    ${count}
                </strong>

            </div>

            <div class="progress">

                <div
                    class="progress-bar"
                    style="width:${
                        count /
                        maxDepartment *
                        100
                    }%">
                </div>

            </div>

        </div>

        `
    )
    .join("");


    const resolved =
    tickets.filter(
        t =>
        t.status === "resolved"
    ).length;


    const resolutionRate =
    tickets.length
    ? Math.round(
        resolved /
        tickets.length *
        100
    )
    : 0;


    const onTime =
    tickets.filter(
        t =>
        t.status === "resolved"
        ||
        new Date(t.deadline)
        > new Date()
    ).length;


    const slaRate =
    tickets.length
    ? Math.round(
        onTime /
        tickets.length *
        100
    )
    : 0;


    document.getElementById(
        "resolutionRate"
    ).textContent =
    resolutionRate + "%";


    document.getElementById(
        "resolutionBar"
    ).style.width =
    resolutionRate + "%";


    document.getElementById(
        "slaRate"
    ).textContent =
    slaRate + "%";


    document.getElementById(
        "slaBar"
    ).style.width =
    slaRate + "%";

}


/* =====================================================
   NAVIGATION
===================================================== */

function showPage(
    pageName,
    element
){

    document
    .querySelectorAll(".page")
    .forEach(
        page =>
        page.classList.remove(
            "active"
        )
    );


    document
    .getElementById(pageName)
    .classList.add(
        "active"
    );


    document
    .querySelectorAll(
        ".nav-item"
    )
    .forEach(
        item =>
        item.classList.remove(
            "active"
        )
    );


    if(element)
        element.classList.add(
            "active"
        );


    if(pageName === "map")
        renderMap();


    if(pageName === "analytics")
        renderAnalytics();

}


function showPageByName(
    pageName
){

    const item =
    [
        ...document.querySelectorAll(
            ".nav-item"
        )
    ]
    .find(
        item =>
        item
        .getAttribute(
            "onclick"
        )
        ?.includes(
            `'${pageName}'`
        )
    );


    showPage(
        pageName,
        item
    );

}


