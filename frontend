<script>

/* =====================================================
   DATABASE
===================================================== */

let tickets =
JSON.parse(
    localStorage.getItem("civicTickets") || "[]"
);

let activities =
JSON.parse(
    localStorage.getItem("civicActivities") || "[]"
);


/* =====================================================
   DEPARTMENTS
===================================================== */

const departments = {

    water:
    "Water Supply Department",

    electricity:
    "Electricity Department",

    road:
    "Roads & Infrastructure Department",

    sanitation:
    "Sanitation Department",

    other:
    "General Civic Department"

};


/* =====================================================
   AI CLASSIFICATION
===================================================== */

function classifyComplaint(text){

    const value =
    text.toLowerCase();


    const keywords = {

        water:[
            "water",
            "leak",
            "pipeline",
            "pipe",
            "drinking",
            "tap",
            "sewage water"
        ],

        electricity:[
            "electric",
            "electricity",
            "power",
            "current",
            "transformer",
            "wire",
            "street light",
            "light"
        ],

        road:[
            "road",
            "pothole",
            "street",
            "traffic",
            "bridge",
            "footpath",
            "pavement"
        ],

        sanitation:[
            "garbage",
            "waste",
            "trash",
            "drain",
            "dirty",
            "sanitation",
            "dump"
        ]

    };


    let best =
    "other";

    let highest =
    0;


    for(
        const category in keywords
    ){

        let score = 0;


        keywords[category].forEach(
            word => {

                if(
                    value.includes(word)
                ){

                    score++;

                }

            }
        );


        if(score > highest){

            highest = score;

            best = category;

        }

    }


    return best;

}


/* =====================================================
   PRIORITY ENGINE
===================================================== */

function calculatePriority(
    urgency,
    text
){

    let score =
    Number(urgency) * 3;


    const value =
    text.toLowerCase();


    const criticalWords = [

        "danger",
        "fire",
        "accident",
        "hospital",
        "injury",
        "critical",
        "emergency",
        "burst",
        "flood",
        "live wire"

    ];


    criticalWords.forEach(
        word => {

            if(value.includes(word)){

                score += 5;

            }

        }
    );


    return Math.min(
        score,
        20
    );

}


/* =====================================================
   SLA
===================================================== */

function getSLAHours(priority){

    if(priority >= 15)
        return 2;

    if(priority >= 8)
        return 12;

    return 48;

}


function getPriorityName(score){

    if(score >= 15)
        return "high";

    if(score >= 8)
        return "medium";

    return "low";

}


/* =====================================================
   TICKET ID
===================================================== */

function generateID(){

    const number =
    1000 + tickets.length + 1;

    return "CG-" + number;

}


/* =====================================================
   SUBMIT
===================================================== */

document
.getElementById("complaintForm")
.addEventListener(
    "submit",
    function(event){

        event.preventDefault();


        const text =
        document
        .getElementById("complaintText")
        .value
        .trim();


        const selectedCategory =
        document
        .getElementById("category")
        .value;


        const urgency =
        document
        .getElementById("urgency")
        .value;


        const location =
        document
        .getElementById("location")
        .value
        .trim();


        const citizen =
        document
        .getElementById("citizen")
        .value
        .trim();


        const phone =
        document
        .getElementById("phone")
        .value
        .trim();


        /* AI CATEGORY */

        const category =
        selectedCategory === "auto"
        ? classifyComplaint(text)
        : selectedCategory;


        /* PRIORITY */

        const priority =
        calculatePriority(
            urgency,
            text
        );


        const priorityName =
        getPriorityName(priority);


        /* DEPARTMENT */

        const department =
        departments[category];


        /* SLA */

        const slaHours =
        getSLAHours(priority);


        const created =
        new Date();


        const deadline =
        new Date(
            created.getTime()
            +
            slaHours *
            60 *
            60 *
            1000
        );


        const ticket = {

            id:generateID(),

            text,

            category,

            urgency:Number(urgency),

            priority,

            priorityName,

            department,

            location,

            citizen,

            phone,

            status:"open",

            created:
            created.toISOString(),

            deadline:
            deadline.toISOString(),

            timeline:[

                {
                    title:
                    "Complaint submitted",

                    time:
                    created.toISOString()
                },

                {
                    title:
                    `AI classified as ${category}`,

                    time:
                    created.toISOString()
                },

                {
                    title:
                    `Automatically routed to ${department}`,

                    time:
                    created.toISOString()
                }

            ]

        };


        tickets.unshift(ticket);


        saveData();


        addActivity(

            `New ${priorityName} priority complaint ${ticket.id} routed to ${department}.`

        );


        event.target.reset();


        document
        .getElementById("urgency")
        .value = "3";


        showToast(

            `Complaint ${ticket.id} successfully routed!`

        );


        updateEverything();

    }
);


/* =====================================================
   STORAGE
===================================================== */

function saveData(){

    localStorage.setItem(
        "civicTickets",
        JSON.stringify(tickets)
    );

    localStorage.setItem(
        "civicActivities",
        JSON.stringify(activities)
    );

}


/* =====================================================
   ACTIVITIES
===================================================== */

function addActivity(text){

    activities.unshift({

        text,

        time:
        new Date().toISOString()

    });


    activities =
    activities.slice(0,20);


    saveData();


    renderActivities();

}


function renderActivities(){

    const container =
    document.getElementById(
        "activityList"
    );


    if(!activities.length){

        container.innerHTML =
        `<p style="color:#64748b">
            No recent activity.
        </p>`;

        return;

    }


    container.innerHTML =
    activities
    .slice(0,8)
    .map(
        activity => `

        <div class="activity-item">

            <div class="activity-icon">
                🔔
            </div>

            <div>

                <div class="activity-text">
                    ${escapeHTML(activity.text)}
                </div>

                <div class="activity-time">
                    ${timeAgo(activity.time)}
                </div>

            </div>

        </div>

        `
    )
    .join("");

}


/* =====================================================
   DASHBOARD
===================================================== */

function updateStats(){

    document.getElementById(
        "totalCount"
    ).textContent =
    tickets.length;


    document.getElementById(
        "openCount"
    ).textContent =

    tickets.filter(
        t =>
        t.status === "open"
        ||
        t.status === "in-progress"
    ).length;


    document.getElementById(
        "resolvedCount"
    ).textContent =

    tickets.filter(
        t =>
        t.status === "resolved"
    ).length;


    document.getElementById(
        "highCount"
    ).textContent =

    tickets.filter(
        t =>
        t.priorityName === "high"
    ).length;


    document.getElementById(
        "escalatedCount"
    ).textContent =

    tickets.filter(
        t =>
        t.status === "escalated"
    ).length;

}


/* =====================================================
   RENDER TICKETS
===================================================== */

function renderTickets(){

    const body =
    document.getElementById(
        "ticketBody"
    );


    const search =
    (
        document.getElementById(
            "search"
        )?.value || ""
    )
    .toLowerCase();


    const status =
    document.getElementById(
        "statusFilter"
    )?.value || "all";


    const category =
    document.getElementById(
        "categoryFilter"
    )?.value || "all";


    const priority =
    document.getElementById(
        "priorityFilter"
    )?.value || "all";


    const filtered =
    tickets.filter(ticket => {

        const combined =
        `
        ${ticket.id}
        ${ticket.text}
        ${ticket.citizen}
        ${ticket.location}
        ${ticket.department}
        `
        .toLowerCase();


        return (

            combined.includes(search)

            &&

            (
                status === "all"
                ||
                ticket.status === status
            )

            &&

            (
                category === "all"
                ||
                ticket.category === category
            )

            &&

            (
                priority === "all"
                ||
                ticket.priorityName === priority
            )

        );

    });


    if(!filtered.length){

        body.innerHTML = `

        <tr>

            <td
                colspan="8"
                style="text-align:center;padding:40px;color:#64748b">

                No complaints found.

            </td>

        </tr>

        `;

        return;

    }


    body.innerHTML =
    filtered
    .map(
        ticket => `

        <tr
            class="ticket-row"
            onclick="openTicket('${ticket.id}')">

            <td>
                <strong>
                    ${ticket.id}
                </strong>
            </td>

            <td>
                ${escapeHTML(
                    ticket.text.substring(
                        0,45
                    )
                )}
                ${ticket.text.length > 45 ? "..." : ""}
            </td>

            <td>
                ${formatCategory(
                    ticket.category
                )}
            </td>

            <td>
                ${priorityBadge(
                    ticket.priority
                )}
            </td>

            <td>
                ${ticket.department}
            </td>

            <td>
                ${statusBadge(
                    ticket.status
                )}
            </td>

            <td>
                ${slaText(ticket)}
            </td>

            <td>
                ${formatDate(
                    ticket.created
                )}
            </td>

        </tr>

        `
    )
    .join("");

}


/* =====================================================
   STATUS
===================================================== */

function statusBadge(status){

    const names = {

        open:"OPEN",

        "in-progress":
        "IN PROGRESS",

        resolved:
        "RESOLVED",

        escalated:
        "ESCALATED"

    };


    return `

    <span class="badge badge-${status}">
        ${names[status] || status}
    </span>

    `;

}


/* =====================================================
   PRIORITY
===================================================== */

function priorityBadge(score){

    const name =
    getPriorityName(score);


    return `

    <span class="badge badge-${name}">
        ${name.toUpperCase()}
        (${score})
    </span>

    `;

}


/* =====================================================
   CATEGORY
===================================================== */

function formatCategory(category){

    const names = {

        water:"💧 Water",

        electricity:
        "⚡ Electricity",

        road:
        "🛣️ Road",

        sanitation:
        "🗑️ Sanitation",

        other:
        "📌 Other"

    };


    return names[category] ||
    category;

}


/* =====================================================
   SLA
===================================================== */

function slaText(ticket){

    if(ticket.status === "resolved"){

        return `
        <span style="color:#16a34a">
            ✓ Completed
        </span>
        `;

    }


    const remaining =
    new Date(ticket.deadline)
    - new Date();


    if(remaining <= 0){

        if(ticket.status !== "escalated"){

            ticket.status =
            "escalated";

            saveData();

        }


        return `
        <span style="color:#dc2626;font-weight:700">
            🚨 Escalated
        </span>
        `;

    }


    const hours =
    Math.floor(
        remaining /
        (1000 * 60 * 60)
    );


    if(hours < 2){

        return `
        <span style="color:#dc2626">
            ${hours}h remaining
        </span>
        `;

    }


    return `
    <span style="color:#d97706">
        ${hours}h remaining
    </span>
    `;

}


/* =====================================================
   OPEN TICKET
===================================================== */

