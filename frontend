/* =====================================================
   CSV EXPORT
===================================================== */

function exportCSV(){

    if(!tickets.length){

        showToast(
            "No complaints to export."
        );

        return;

    }


    let csv =
    "ID,Complaint,Category,Priority,Department,Status,Location,Citizen,Phone,Created\n";


    tickets.forEach(
        ticket => {

            csv += [

                ticket.id,

                ticket.text,

                ticket.category,

                ticket.priority,

                ticket.department,

                ticket.status,

                ticket.location,

                ticket.citizen,

                ticket.phone,

                ticket.created

            ]
            .map(
                value =>
                `"${String(value || "")
                .replace(/"/g,'""')}"`
            )
            .join(",")
            +
            "\n";

        }
    );


    const blob =
    new Blob(
        [csv],
        {
            type:"text/csv"
        }
    );


    const url =
    URL.createObjectURL(blob);


    const link =
    document.createElement("a");


    link.href =
    url;


    link.download =
    "civic-grievances.csv";


    link.click();


    URL.revokeObjectURL(url);


    showToast(
        "CSV exported successfully."
    );

}


