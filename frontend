   RESET DEMO
===================================================== */

function resetDemo(){

    if(
        !confirm(
            "Reset all demo complaints?"
        )
    )
        return;


    tickets = [];

    activities = [];


    saveData();


    updateEverything();


    showToast(
        "Dashboard reset."
    );

}


