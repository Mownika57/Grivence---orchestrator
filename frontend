            </div>

            <div class="detail-value">
                ${escapeHTML(ticket.text)}
            </div>

        </div>


        <div class="detail">

            <div class="detail-label">
                AI Classification
            </div>

            <div class="detail-value">
                ${formatCategory(ticket.category)}
                →
                ${ticket.department}
            </div>

        </div>


