<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Civic Resolve</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, Helvetica, sans-serif;
}

body {
    background: #f4f7fb;
    color: #1f2937;
}

/* HEADER */
header {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: white;
    padding: 22px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 26px;
    font-weight: bold;
}

.tagline {
    font-size: 14px;
    opacity: 0.9;
}

/* MAIN */
.container {
    width: 92%;
    max-width: 1400px;
    margin: 30px auto;
}

/* CARDS */
.card {
    background: white;
    border-radius: 14px;
    padding: 25px;
    margin-bottom: 25px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.07);
}

.card h2 {
    margin-bottom: 20px;
    color: #1e3a8a;
}

/* FORM */
.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group.full {
    grid-column: 1 / -1;
}

label {
    font-weight: bold;
    margin-bottom: 7px;
}

input,
select,
textarea {
    padding: 12px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 15px;
    outline: none;
}

input:focus,
select:focus,
textarea:focus {
    border-color: #2563eb;
}

textarea {
    resize: vertical;
    min-height: 120px;
}

.char-counter {
    text-align: right;
    font-size: 12px;
    color: #6b7280;
    margin-top: 4px;
}

/* BUTTONS */
button {
    border: none;
    border-radius: 8px;
    padding: 12px 18px;
    cursor: pointer;
    font-weight: bold;
    font-size: 14px;
}

.primary-btn {
    background: #2563eb;
    color: white;
}

.primary-btn:hover {
    background: #1d4ed8;
}

.secondary-btn {
    background: #e5e7eb;
    color: #111827;
}

.location-btn {
    background: #059669;
    color: white;
    margin-top: 5px;
}

.location-btn:hover {
    background: #047857;
}

.submit-area {
    margin-top: 22px;
    display: flex;
    gap: 10px;
    align-items: center;
}

.status-message {
    font-size: 14px;
    font-weight: bold;
}

/* DASHBOARD STATS */
.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    margin-bottom: 25px;
}

.stat {
    background: white;
    padding: 20px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.06);
}

.stat-title {
    color: #6b7280;
    font-size: 14px;
}

.stat-value {
    font-size: 30px;
    font-weight: bold;
    margin-top: 5px;
}

/* FILTERS */
.controls {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 20px;
}

.filter-btn {
    background: #e5e7eb;
    color: #374151;
}

.filter-btn.active {
    background: #2563eb;
    color: white;
}

.search-box {
    flex: 1;
    min-width: 220px;
}

/* TABLE */
.table-container {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 850px;
}

th,
td {
    padding: 13px;
    border-bottom: 1px solid #e5e7eb;
    text-align: left;
}

th {
    background: #f8fafc;
    color: #374151;
}

tr:hover {
    background: #f8fafc;
}

/* BADGES */
.badge {
    padding: 5px 9px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: bold;
    display: inline-block;
}

.open {
    background: #dbeafe;
    color: #1d4ed8;
}

.escalated {
    background: #fee2e2;
    color: #b91c1c;
}

.resolved {
    background: #dcfce7;
    color: #15803d;
}

/* MAP */
#map {
    width: 100%;
    height: 450px;
    border-radius: 12px;
    overflow: hidden;
}

/* EMPTY */
.empty {
    text-align: center;
    padding: 30px;
    color: #6b7280;
}

/* FILE */
.file-info {
    margin-top: 6px;
    font-size: 13px;
    color: #6b7280;
}

/* LOCATION */
.location-display {
    background: #f0fdf4;
    padding: 10px;
    border-radius: 8px;
    color: #166534;
    font-size: 13px;
    margin-top: 8px;
}

/* FOOTER */
footer {
    text-align: center;
    padding: 25px;
    color: #6b7280;
}

/* RESPONSIVE */
@media (max-width: 800px) {

    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-group.full {
        grid-column: auto;
    }

    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

    header {
        flex-direction: column;
        align-items: flex-start;
        gap: 5px;
    }
}

@media (max-width: 500px) {

    .stats {
        grid-template-columns: 1fr;
    }

    .container {
        width: 95%;
    }
}
</style>
</head>

<body>

<header>
    <div>
        <div class="logo">🏛️ Civic Resolve</div>
        <div class="tagline">Smart Community Grievance Resolution Platform</div>
    </div>
</header>


<div class="container">

    <!-- COMPLAINT FORM -->
    <div class="card">

        <h2>Submit a Complaint</h2>

        <form id="complaintForm">

            <div class="form-grid">

                <!-- CATEGORY -->
                <div class="form-group">
                    <label for="category">Category</label>

                    <select id="category" required>
                        <option value="">Select category</option>
                        <option value="Water">Water</option>
                        <option value="Electricity">Electricity</option>
                        <option value="Road">Road</option>
                        <option value="Sanitation">Sanitation</option>
                        <option value="Other">Other</option>
                    </select>
                </div>


                <!-- CUSTOM CATEGORY -->
                <div class="form-group" id="customCategoryGroup" style="display:none;">

                    <label for="customCategory">
                        Mention the type of problem
                    </label>

                    <input
                        type="text"
                        id="customCategory"
                        placeholder="Example: Street light"
                    >

                </div>


                <!-- URGENCY -->
                <div class="form-group">

                    <label for="urgency">
                        How urgent is it?
                    </label>

                    <select id="urgency" required>
                        <option value="">Select urgency</option>
                        <option value="1">1 - Low</option>
                        <option value="2">2 - Slightly Low</option>
                        <option value="3">3 - Medium</option>
                        <option value="4">4 - High</option>
                        <option value="5">5 - Critical</option>
                    </select>

                </div>


                <!-- PROBLEM -->
                <div class="form-group full">

                    <label for="description">
                        What is the problem?
                    </label>

                    <textarea
                        id="description"
                        maxlength="500"
                        placeholder="Describe your problem clearly..."
                        required
                    ></textarea>

                    <div class="char-counter">
                        <span id="charCount">0</span>/500
                    </div>

                </div>


                <!-- CONTACT -->
                <div class="form-group">

                    <label for="contact">
                        Contact Number
                    </label>

                    <input
                        type="tel"
                        id="contact"
                        maxlength="10"
                        pattern="[0-9]{10}"
                        placeholder="Enter 10-digit number"
                        required
                    >

                </div>


                <!-- FILE -->
                <div class="form-group">

                    <label for="file">
                        Choose Image
                    </label>

                    <input
                        type="file"
                        id="file"
                        accept=".jpg,.jpeg,.png,.webp,.pdf,.doc,.docx"
                    >

                    <div class="file-info" id="fileInfo">
                        Maximum file size: 10 MB
                    </div>

                </div>


                <!-- LOCATION -->
                <div class="form-group full">

                    <label>
                        Location
                    </label>

                    <button
                        type="button"
                        class="location-btn"
                        id="locationBtn"
                    >
                        📍 Use My Current Location
                    </button>

                    <div
                        id="locationDisplay"
                        class="location-display"
                        style="display:none;"
                    ></div>

                </div>

            </div>


            <div class="submit-area">

                <button
                    type="submit"
                    class="primary-btn"
                >
                    Submit Complaint
                </button>

                <span
                    id="statusMessage"
                    class="status-message"
                ></span>

            </div>

        </form>

    </div>


    <!-- STATISTICS -->
    <div class="stats">

        <div class="stat">
            <div class="stat-title">Total Complaints</div>
            <div class="stat-value" id="totalCount">0</div>
        </div>

        <div class="stat">
            <div class="stat-title">Open</div>
            <div class="stat-value" id="openCount">0</div>
        </div>

        <div class="stat">
            <div class="stat-title">Escalated</div>
            <div class="stat-value" id="escalatedCount">0</div>
        </div>

        <div class="stat">
            <div class="stat-title">Resolved</div>
            <div class="stat-value" id="resolvedCount">0</div>
        </div>

    </div>


    <!-- MAP -->
    <div class="card">

        <h2>📍 Complaint Map</h2>

        <div id="map"></div>

    </div>


    <!-- DASHBOARD -->
    <div class="card">

        <h2>Complaint Dashboard</h2>


        <div class="controls">

            <button
                class="filter-btn active"
                data-filter="All"
            >
                All
            </button>

            <button
                class="filter-btn"
                data-filter="Open"
            >
                Open
            </button>

            <button
                class="filter-btn"
                data-filter="Escalated"
            >
                Escalated
            </button>

            <button
                class="filter-btn"
                data-filter="Resolved"
            >
                Resolved
            </button>

            <input
                class="search-box"
                type="text"
                id="search"
                placeholder="🔍 Search complaints..."
            >

        </div>


        <div class="table-container">

            <table>

                <thead>

                    <tr>
                        <th>ID</th>
                        <th>Category</th>
                        <th>Problem</th>
                        <th>Urgency</th>
                        <th>Department</th>
                        <th>Status</th>
                        <th>Location</th>
                    </tr>

                </thead>

                <tbody id="complaintTable">

                </tbody>

            </table>

        </div>

    </div>

</div>


<footer>
    Civic Resolve © 2026 | Hackathon Prototype
</footer>


<script>

/* =========================================================
   CIVIC RESOLVE
   ========================================================= */


/* GOOGLE MAP */
let map = null;
let mapMarkers = [];


/* CURRENT LOCATION */
let currentLocation = null;


/* ACTIVE FILTER */
let activeFilter = "All";


/* STORAGE KEY */
const STORAGE_KEY = "civicResolveComplaints";


/* =========================================================
   GOOGLE MAP INITIALIZATION
   ========================================================= */

async function initMap() {

    try {

        const { Map } =
            await google.maps.importLibrary("maps");

        map = new Map(
            document.getElementById("map"),
            {
                center: {
                    lat: 11.3410,
                    lng: 77.7172
                },

                zoom: 7,

                mapTypeControl: true,

                streetViewControl: true,

                fullscreenControl: true
            }
        );

        renderMap();

    } catch (error) {

        console.error(
            "Google Maps could not be loaded:",
            error
        );

        document.getElementById("map").innerHTML =
            `
            <div style="
                height:100%;
                display:flex;
                justify-content:center;
                align-items:center;
                text-align:center;
                padding:20px;
                background:#f3f4f6;
                color:#6b7280;
            ">
                <div>
                    <h3>Google Maps could not load</h3>
                    <p>
                        Please check your API key,
                        Google Maps JavaScript API,
                        and API restrictions.
                    </p>
                </div>
            </div>
            `;

    }

}


/* =========================================================
   LOCAL STORAGE
   ========================================================= */

function getComplaints() {

    try {

        return JSON.parse(
            localStorage.getItem(STORAGE_KEY)
        ) || [];

    } catch {

        return [];

    }

}


function saveComplaints(complaints) {

    localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify(complaints)
    );

}


/* =========================================================
   CATEGORY
   ========================================================= */

const category =
    document.getElementById("category");

const customCategoryGroup =
    document.getElementById(
        "customCategoryGroup"
    );

const customCategory =
    document.getElementById(
        "customCategory"
    );


category.addEventListener(
    "change",
    function () {

        if (this.value === "Other") {

            customCategoryGroup.style.display =
                "flex";

            customCategory.required = true;

        } else {

            customCategoryGroup.style.display =
                "none";

            customCategory.required = false;

            customCategory.value = "";

        }

    }
);


/* =========================================================
   CHARACTER COUNTER
   ========================================================= */

const description =
    document.getElementById("description");

const charCount =
    document.getElementById("charCount");


description.addEventListener(
    "input",
    function () {

        charCount.textContent =
            this.value.length;

    }
);


/* =========================================================
   FILE VALIDATION
   ========================================================= */

const fileInput =
    document.getElementById("file");

const fileInfo =
    document.getElementById("fileInfo");


fileInput.addEventListener(
    "change",
    function () {

        const file = this.files[0];

        if (!file) {

            fileInfo.textContent =
                "Maximum file size: 10 MB";

            return;

        }


        const maxSize =
            10 * 1024 * 1024;


        if (file.size > maxSize) {

            alert(
                "File size must be less than 10 MB."
            );

            this.value = "";

            fileInfo.textContent =
                "Maximum file size: 10 MB";

            return;

        }


        fileInfo.textContent =
            `${file.name} selected (${formatFileSize(file.size)})`;

    }
);


function formatFileSize(bytes) {

    if (bytes < 1024)
        return bytes + " B";

    if (bytes < 1024 * 1024)
        return (bytes / 1024).toFixed(1) + " KB";

    return (
        bytes / (1024 * 1024)
    ).toFixed(1) + " MB";

}


/* =========================================================
   LOCATION
   ========================================================= */

const locationBtn =
    document.getElementById(
        "locationBtn"
    );

const locationDisplay =
    document.getElementById(
        "locationDisplay"
    );


locationBtn.addEventListener(
    "click",
    function () {

        if (!navigator.geolocation) {

            alert(
                "Geolocation is not supported by this browser."
            );

            return;

        }


        locationBtn.disabled = true;

        locationBtn.textContent =
            "📍 Getting location...";


        navigator.geolocation.getCurrentPosition(

            function (position) {

                currentLocation = {

                    lat:
                        position.coords.latitude,

                    lng:
                        position.coords.longitude

                };


                locationDisplay.style.display =
                    "block";


                locationDisplay.innerHTML =
                    `
                    <strong>Location captured:</strong><br>
                    Latitude:
                    ${currentLocation.lat.toFixed(6)}
                    <br>
                    Longitude:
                    ${currentLocation.lng.toFixed(6)}
                    `;


                locationBtn.disabled =
                    false;

                locationBtn.textContent =
                    "📍 Location Captured";


                if (map) {

                    map.setCenter(
                        currentLocation
                    );

                    map.setZoom(15);

                }

            },

            function (error) {

                console.error(error);

                alert(
                    "Unable to get your location. Please allow location permission."
                );


                locationBtn.disabled =
                    false;

                locationBtn.textContent =
                    "📍 Use My Current Location";

            },

            {
                enableHighAccuracy: true,
                timeout: 10000,
                maximumAge: 0
            }

        );

    }
);


/* =========================================================
   PRIORITY
   ========================================================= */

function calculatePriority(urgency) {

    urgency = Number(urgency);

    if (urgency >= 5)
        return "Critical";

    if (urgency >= 4)
        return "High";

    if (urgency >= 3)
        return "Medium";

    return "Low";

}


/* =========================================================
   DEPARTMENT ROUTING
   ========================================================= */

function getDepartment(category) {

    const departments = {

        "Water":
            "Water Department",

        "Electricity":
            "Electricity Department",

        "Road":
            "Road & Transport Department",

        "Sanitation":
            "Sanitation Department"

    };


    return departments[category]
        || "General Administration";

}


/* =========================================================
   FORM SUBMISSION
   ========================================================= */

const complaintForm =
    document.getElementById(
        "complaintForm"
    );

const statusMessage =
    document.getElementById(
        "statusMessage"
    );


complaintForm.addEventListener(
    "submit",
    function (event) {

        event.preventDefault();


        const categoryValue =
            category.value;


        const customValue =
            customCategory.value.trim();


        const urgency =
            document.getElementById(
                "urgency"
            ).value;


        const descriptionValue =
            description.value.trim();


        const contact =
            document.getElementById(
                "contact"
            ).value.trim();


        const file =
            fileInput.files[0];


        /* CONTACT VALIDATION */

        if (!/^[0-9]{10}$/.test(contact)) {

            alert(
                "Please enter a valid 10-digit contact number."
            );

            return;

        }


        /* LOCATION */

        if (!currentLocation) {

            const confirmWithoutLocation =
                confirm(
                    "Location has not been captured. Submit without location?"
                );

            if (!confirmWithoutLocation)
                return;

        }


        /* FILE SIZE */

        if (file) {

            const maxSize =
                10 * 1024 * 1024;

            if (file.size > maxSize) {

                alert(
                    "File must be smaller than 10 MB."
                );

                return;

            }

        }


        /* FINAL CATEGORY */

        const finalCategory =
            categoryValue === "Other"
                ? customValue
                : categoryValue;


        /* CREATE ID */

        const id =
            "CR-" +
            Date.now().toString().slice(-6);


        /* CREATE COMPLAINT */

        const complaint = {

            id: id,

            category:
                finalCategory,

            originalCategory:
                categoryValue,

            urgency:
                Number(urgency),

            priority:
                calculatePriority(urgency),

            description:
                descriptionValue,

            contact:
                contact,

            fileName:
                file ? file.name : "",

            latitude:
                currentLocation
                    ? currentLocation.lat
                    : null,

            longitude:
                currentLocation
                    ? currentLocation.lng
                    : null,

            department:
                getDepartment(categoryValue),

            status:
                Number(urgency) >= 5
                    ? "Escalated"
                    : "Open",

            createdAt:
                new Date().toISOString()

        };


        /* SAVE */

        const complaints =
            getComplaints();


        complaints.unshift(
            complaint
        );


        saveComplaints(
            complaints
        );


        /* SUCCESS */

        statusMessage.textContent =
            "✓ Complaint submitted successfully!";

        statusMessage.style.color =
            "#15803d";


        /* RESET */

        complaintForm.reset();

        customCategoryGroup.style.display =
            "none";

        customCategory.required =
            false;

        currentLocation =
            null;

        locationDisplay.style.display =
            "none";

        locationBtn.disabled =
            false;

        locationBtn.textContent =
            "📍 Use My Current Location";


        fileInfo.textContent =
            "Maximum file size: 10 MB";


        charCount.textContent =
            "0";


        /* REFRESH */

        renderDashboard();

        renderMap();


        setTimeout(
            function () {

                statusMessage.textContent =
                    "";

            },
            4000
        );

    }
);


/* =========================================================
   DASHBOARD
   ========================================================= */

function renderDashboard() {

    const complaints =
        getComplaints();


    /* STATS */

    const total =
        complaints.length;


    const open =
        complaints.filter(
            c => c.status === "Open"
        ).length;


    const escalated =
        complaints.filter(
            c => c.status === "Escalated"
        ).length;


    const resolved =
        complaints.filter(
            c => c.status === "Resolved"
        ).length;


    document.getElementById(
        "totalCount"
    ).textContent = total;


    document.getElementById(
        "openCount"
    ).textContent = open;


    document.getElementById(
        "escalatedCount"
    ).textContent = escalated;


    document.getElementById(
        "resolvedCount"
    ).textContent = resolved;


    /* FILTER */

    const searchText =
        document.getElementById(
            "search"
        ).value.toLowerCase();


    const filtered =
        complaints.filter(
            complaint => {

                const filterMatch =
                    activeFilter === "All"
                    ||
                    complaint.status ===
                    activeFilter;


                const searchMatch =
                    complaint.description
                        .toLowerCase()
                        .includes(searchText)
                    ||
                    complaint.category
                        .toLowerCase()
                        .includes(searchText)
                    ||
                    complaint.id
                        .toLowerCase()
                        .includes(searchText);


                return (
                    filterMatch &&
                    searchMatch
                );

            }
        );


    renderTable(filtered);

}


/* =========================================================
   TABLE
   ========================================================= */

function renderTable(complaints) {

    const table =
        document.getElementById(
            "complaintTable"
        );


    if (complaints.length === 0) {

        table.innerHTML =
            `
            <tr>
                <td colspan="7">
                    <div class="empty">
                        No complaints found.
                    </div>
                </td>
            </tr>
            `;

        return;

    }


    table.innerHTML =
        complaints.map(
            complaint => {

                const location =
                    complaint.latitude !== null
                    &&
                    complaint.longitude !== null

                    ? `
                        <a
                            href="https://www.google.com/maps/search/?api=1&query=${complaint.latitude},${complaint.longitude}"
                            target="_blank"
                            rel="noopener"
                        >
                            📍 View Map
                        </a>
                      `

                    : "Not available";


                const statusClass =
                    complaint.status
                        .toLowerCase();


                return `

                <tr>

                    <td>
                        <strong>
                            ${escapeHTML(complaint.id)}
                        </strong>
                    </td>

                    <td>
                        ${escapeHTML(complaint.category)}
                    </td>

                    <td>
                        ${escapeHTML(
                            complaint.description
                        )}
                    </td>

                    <td>
                        <strong>
                            ${complaint.urgency}/5
                        </strong>
                        <br>
                        <small>
                            ${escapeHTML(
                                complaint.priority
                            )}
                        </small>
                    </td>

                    <td>
                        ${escapeHTML(
                            complaint.department
                        )}
                    </td>

                    <td>
                        <span
                            class="badge ${statusClass}"
                        >
                            ${escapeHTML(
                                complaint.status
                            )}
                        </span>
                    </td>

                    <td>
                        ${location}
                    </td>

                </tr>

                `;

            }
        ).join("");

}


/* =========================================================
   ESCAPE HTML
   ========================================================= */

function escapeHTML(value) {

    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

}


/* =========================================================
   FILTER BUTTONS
   ========================================================= */

document.querySelectorAll(
    ".filter-btn"
).forEach(
    button => {

        button.addEventListener(
            "click",
            function () {

                document.querySelectorAll(
                    ".filter-btn"
                ).forEach(
                    btn =>
                        btn.classList.remove(
                            "active"
                        )
                );


                this.classList.add(
                    "active"
                );


                activeFilter =
                    this.dataset.filter;


                renderDashboard();

            }
        );

    }
);


/* =========================================================
   SEARCH
   ========================================================= */

document.getElementById(
    "search"
).addEventListener(
    "input",
    renderDashboard
);


/* =========================================================
   MAP MARKERS
   ========================================================= */

function renderMap() {

    if (!map)
        return;


    /* REMOVE OLD MARKERS */

    mapMarkers.forEach(
        marker => marker.setMap(null)
    );


    mapMarkers = [];


    const complaints =
        getComplaints();


    const validComplaints =
        complaints.filter(
            complaint =>
                complaint.latitude !== null
                &&
                complaint.longitude !== null
        );


    /* CREATE MARKERS */

    validComplaints.forEach(
        complaint => {

            const position = {

                lat:
                    Number(
                        complaint.latitude
                    ),

                lng:
                    Number(
                        complaint.longitude
                    )

            };


            const marker =
                new google.maps.Marker({

                    position:
                        position,

                    map:
                        map,

                    title:
                        complaint.id

                });


            const infoWindow =
                new google.maps.InfoWindow({

                    content:
                        `
                        <div style="
                            min-width:220px;
                            padding:5px;
                        ">

                            <h3>
                                ${escapeHTML(
                                    complaint.category
                                )}
                            </h3>

                            <p>
                                <strong>
                                    ID:
                                </strong>
                                ${escapeHTML(
                                    complaint.id
                                )}
                            </p>

                            <p>
                                <strong>
                                    Problem:
                                </strong>
                                ${escapeHTML(
                                    complaint.description
                                )}
                            </p>

                            <p>
                                <strong>
                                    Urgency:
                                </strong>
                                ${complaint.urgency}/5
                            </p>

                            <p>
                                <strong>
                                    Status:
                                </strong>
                                ${escapeHTML(
                                    complaint.status
                                )}
                            </p>

                            <p>
                                <strong>
                                    Department:
                                </strong>
                                ${escapeHTML(
                                    complaint.department
                                )}
                            </p>

                        </div>
                        `

                });


            marker.addListener(
                "click",
                function () {

                    infoWindow.open({
                        map: map,
                        anchor: marker
                    });

                }
            );


            mapMarkers.push(
                marker
            );

        }
    );


    /* FIT MAP */

    if (validComplaints.length > 0) {

        const bounds =
            new google.maps.LatLngBounds();


        validComplaints.forEach(
            complaint => {

                bounds.extend({

                    lat:
                        Number(
                            complaint.latitude
                        ),

                    lng:
                        Number(
                            complaint.longitude
                        )

                });

            }
        );


        map.fitBounds(bounds);

    }

}


/* =========================================================
   INITIAL LOAD
   ========================================================= */

renderDashboard();


</script>


