<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CivicResolve — Community Grievance Orchestrator</title>

<style>

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Inter,Segoe UI,Arial,sans-serif;
}

:root{
    --primary:#2563eb;
    --primary-dark:#1d4ed8;
    --bg:#f4f7fb;
    --card:#ffffff;
    --text:#172033;
    --muted:#64748b;
    --border:#e2e8f0;
    --danger:#dc2626;
    --warning:#d97706;
    --success:#16a34a;
    --sidebar:#111827;
}

body{
    background:var(--bg);
    color:var(--text);
    min-height:100vh;
}

/* =========================
   SIDEBAR
========================= */

.sidebar{
    position:fixed;
    left:0;
    top:0;
    width:250px;
    height:100vh;
    background:var(--sidebar);
    color:white;
    padding:25px 18px;
    z-index:50;
}

.logo{
    font-size:21px;
    font-weight:800;
    margin-bottom:35px;
    padding:0 8px;
}

.logo span{
    color:#60a5fa;
}

.nav-title{
    color:#64748b;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:1px;
    margin:20px 10px 8px;
}

.nav-item{
    padding:12px 14px;
    margin-bottom:6px;
    border-radius:9px;
    cursor:pointer;
    color:#cbd5e1;
    transition:.2s;
}

.nav-item:hover,
.nav-item.active{
    background:#1e40af;
    color:white;
}

/* =========================
   MAIN
========================= */

.main{
    margin-left:250px;
    padding:28px;
}

.page{
    display:none;
}

.page.active{
    display:block;
}

.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;
}

.topbar h1{
    font-size:26px;
}

.subtitle{
    color:var(--muted);
    margin-top:5px;
    font-size:14px;
}

.actions{
    display:flex;
    gap:10px;
}

.btn{
    border:none;
    padding:10px 15px;
    border-radius:8px;
    cursor:pointer;
    font-weight:600;
}

.btn-primary{
    background:var(--primary);
    color:white;
}

.btn-primary:hover{
    background:var(--primary-dark);
}

.btn-light{
    background:white;
    border:1px solid var(--border);
    color:var(--text);
}

/* =========================
   STAT CARDS
========================= */

.stats{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:16px;
    margin-bottom:22px;
}

.stat{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:13px;
    padding:19px;
    box-shadow:0 3px 12px rgba(15,23,42,.04);
}

.stat-icon{
    font-size:22px;
    margin-bottom:12px;
}

.stat-title{
    color:var(--muted);
    font-size:12px;
    font-weight:600;
}

.stat-number{
    font-size:29px;
    font-weight:800;
    margin-top:6px;
}

.stat-description{
    color:var(--muted);
    font-size:11px;
    margin-top:5px;
}

/* =========================
   GRID
========================= */

.grid-2{
    display:grid;
    grid-template-columns:380px 1fr;
    gap:20px;
}

.grid-3{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:13px;
    padding:20px;
    box-shadow:0 3px 12px rgba(15,23,42,.04);
}

.card h2{
    font-size:18px;
    margin-bottom:16px;
}

.card-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:16px;
}

/* =========================
   FORM
========================= */

label{
    display:block;
    font-size:12px;
    font-weight:700;
    margin:13px 0 5px;
}

input,
select,
textarea{
    width:100%;
    padding:10px 11px;
    border:1px solid #d7dee8;
    border-radius:7px;
    background:white;
    font-size:14px;
    outline:none;
    color:var(--text);
}

input:focus,
select:focus,
textarea:focus{
    border-color:var(--primary);
    box-shadow:0 0 0 3px rgba(37,99,235,.08);
}

textarea{
    min-height:90px;
    resize:vertical;
}

.form-row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
}

.file-box{
    border:1px dashed #cbd5e1;
    padding:13px;
    border-radius:8px;
    background:#f8fafc;
}

.submit-btn{
    width:100%;
    margin-top:18px;
    padding:13px;
    border:none;
    border-radius:8px;
    background:var(--primary);
    color:white;
    font-weight:700;
    cursor:pointer;
}

/* =========================
   TABLE
========================= */

.controls{
    display:flex;
    gap:9px;
    margin-bottom:15px;
}

.search{
    flex:1;
}

.controls select{
    width:145px;
}

.table-wrap{
    overflow:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    font-size:13px;
}

th{
    text-align:left;
    padding:12px;
    background:#f8fafc;
    color:#64748b;
    font-size:11px;
    text-transform:uppercase;
}

td{
    padding:12px;
    border-bottom:1px solid #edf1f5;
}

.ticket-row{
    cursor:pointer;
}

.ticket-row:hover{
    background:#f8fafc;
}

/* =========================
   BADGES
========================= */

.badge{
    display:inline-block;
    padding:4px 9px;
    border-radius:20px;
    font-size:10px;
    font-weight:800;
}

.badge-high{
    color:#b91c1c;
    background:#fee2e2;
}

.badge-medium{
    color:#b45309;
    background:#fef3c7;
}

.badge-low{
    color:#15803d;
    background:#dcfce7;
}

.badge-open{
    color:#1d4ed8;
    background:#dbeafe;
}

.badge-progress{
    color:#7c3aed;
    background:#ede9fe;
}

.badge-resolved{
    color:#15803d;
    background:#dcfce7;
}

.badge-escalated{
    color:#b91c1c;
    background:#fee2e2;
}

/* =========================
   ACTIVITY
========================= */

.activity-item{
    display:flex;
    gap:12px;
    padding:13px 0;
    border-bottom:1px solid #edf1f5;
}

.activity-icon{
    width:35px;
    height:35px;
    border-radius:50%;
    background:#eff6ff;
    display:flex;
    align-items:center;
    justify-content:center;
}

.activity-text{
    font-size:13px;
}

.activity-time{
    color:#94a3b8;
    font-size:11px;
    margin-top:3px;
}

/* =========================
   PROGRESS
========================= */

.progress{
    height:8px;
    border-radius:20px;
    background:#e2e8f0;
    overflow:hidden;
    margin-top:8px;
}

.progress-bar{
    height:100%;
    border-radius:20px;
    background:var(--primary);
}

/* =========================
   DEPARTMENT
========================= */

.department{
    padding:14px 0;
    border-bottom:1px solid #edf1f5;
}

.department-top{
    display:flex;
    justify-content:space-between;
    font-size:13px;
}

/* =========================
   MAP
========================= */

.map{
    height:340px;
    border-radius:12px;
    background:
        linear-gradient(90deg,rgba(148,163,184,.18) 1px,transparent 1px),
        linear-gradient(rgba(148,163,184,.18) 1px,transparent 1px),
        #eaf2e7;
    background-size:45px 45px;
    position:relative;
    overflow:hidden;
}

.road{
    position:absolute;
    background:#cbd5e1;
    height:14px;
    transform:rotate(-20deg);
    width:120%;
    top:48%;
    left:-10%;
}

.road2{
    position:absolute;
    background:#cbd5e1;
    width:14px;
    height:120%;
    transform:rotate(15deg);
    left:55%;
    top:-10%;
}

.map-marker{
    position:absolute;
    width:18px;
    height:18px;
    border-radius:50%;
    border:3px solid white;
    box-shadow:0 2px 6px rgba(0,0,0,.3);
    cursor:pointer;
}

.marker-high{
    background:#dc2626;
}

.marker-medium{
    background:#d97706;
}

.marker-low{
    background:#16a34a;
}

/* =========================
   TIMELINE
========================= */

.timeline{
    position:relative;
    padding-left:25px;
}

.timeline:before{
    content:"";
    position:absolute;
    left:7px;
    top:5px;
    bottom:5px;
    width:2px;
    background:#dbe2ea;
}

.timeline-item{
    position:relative;
    margin-bottom:18px;
}

.timeline-dot{
    position:absolute;
    left:-22px;
    top:2px;
    width:12px;
    height:12px;
    background:var(--primary);
    border-radius:50%;
    border:2px solid white;
}

.timeline-title{
    font-size:13px;
    font-weight:700;
}

.timeline-time{
    color:#94a3b8;
    font-size:11px;
    margin-top:3px;
}

/* =========================
   MODAL
========================= */

.modal{
    position:fixed;
    inset:0;
    background:rgba(15,23,42,.6);
    display:none;
    align-items:center;
    justify-content:center;
    z-index:100;
    padding:20px;
}

.modal-box{
    background:white;
    width:650px;
    max-width:100%;
    max-height:90vh;
    overflow:auto;
    border-radius:14px;
    padding:25px;
}

.modal-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.close{
    background:none;
    border:none;
    font-size:25px;
    cursor:pointer;
}

.detail{
    padding:12px 0;
    border-bottom:1px solid #edf1f5;
}

.detail-label{
    color:#64748b;
    font-size:11px;
    font-weight:700;
    text-transform:uppercase;
    margin-bottom:4px;
}

.detail-value{
    font-size:14px;
}

.modal-actions{
    display:flex;
    gap:10px;
    margin-top:20px;
}

/* =========================
   TOAST
========================= */

.toast{
    position:fixed;
    right:25px;
    bottom:25px;
    padding:13px 18px;
    background:#111827;
    color:white;
    border-radius:9px;
    display:none;
    z-index:200;
    box-shadow:0 8px 25px rgba(0,0,0,.2);
}

/* =========================
   DARK MODE
========================= */

body.dark{
    --bg:#0f172a;
    --card:#1e293b;
    --text:#e5e7eb;
    --muted:#94a3b8;
    --border:#334155;
}

body.dark input,
body.dark select,
body.dark textarea{
    background:#172033;
    color:#e5e7eb;
    border-color:#475569;
}

body.dark th{
    background:#172033;
}

body.dark .ticket-row:hover{
    background:#172033;
}

body.dark .btn-light{
    background:#1e293b;
    color:#e5e7eb;
}

body.dark .file-box{
    background:#172033;
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:1100px){

    .sidebar{
        width:75px;
    }

    .logo{
        font-size:0;
    }

    .logo span{
        font-size:20px;
    }

    .nav-item{
        text-align:center;
        font-size:0;
    }

    .main{
        margin-left:75px;
    }

    .stats{
        grid-template-columns:repeat(2,1fr);
    }

    .grid-2{
        grid-template-columns:1fr;
    }
}

@media(max-width:700px){

    .main{
        padding:15px;
    }

    .topbar{
        flex-direction:column;
        align-items:flex-start;
    }

    .stats{
        grid-template-columns:1fr 1fr;
    }

    .form-row{
        grid-template-columns:1fr;
    }

    .controls{
        flex-direction:column;
    }

    .controls select{
        width:100%;
    }

}

</style>
</head>


<body>


<!-- =====================================================
     SIDEBAR
===================================================== -->

<aside class="sidebar">

    <div class="logo">
        🏛️ Civic<span>Resolve</span>
    </div>

    <div class="nav-title">
        MAIN
    </div>

    <div
        class="nav-item active"
        onclick="showPage('dashboard',this)">
        📊 Dashboard
    </div>

    <div
        class="nav-item"
        onclick="showPage('complaints',this)">
        🎫 Complaints
    </div>

    <div
        class="nav-item"
        onclick="showPage('map',this)">
        🗺️ Complaint Map
    </div>

    <div
        class="nav-item"
        onclick="showPage('analytics',this)">
        📈 Analytics
    </div>

    <div class="nav-title">
        SYSTEM
    </div>

    <div
        class="nav-item"
        onclick="toggleDarkMode()">
        🌙 Dark Mode
    </div>

    <div
        class="nav-item"
        onclick="resetDemo()">
        🔄 Reset Demo
    </div>

</aside>


<!-- =====================================================
     MAIN
===================================================== -->

<main class="main">


<!-- =====================================================
     DASHBOARD
===================================================== -->

<section
    id="dashboard"
    class="page active">

    <div class="topbar">

        <div>

            <h1>
                Community Grievance Dashboard
            </h1>

            <div class="subtitle">
                AI-assisted civic complaint routing and resolution
            </div>

        </div>

        <div class="actions">

            <button
                class="btn btn-light"
                onclick="toggleDarkMode()">

                🌙

            </button>

            <button
                class="btn btn-light"
                onclick="exportCSV()">

                📥 Export

            </button>

        </div>

    </div>


    <!-- STATS -->

    <div class="stats">

        <div class="stat">

            <div class="stat-icon">
                🎫
            </div>

            <div class="stat-title">
                TOTAL COMPLAINTS
            </div>

            <div
                class="stat-number"
                id="totalCount">
                0
            </div>

            <div class="stat-description">
                All registered complaints
            </div>

        </div>


        <div class="stat">

            <div class="stat-icon">
                🔵
            </div>

            <div class="stat-title">
                OPEN
            </div>

            <div
                class="stat-number"
                id="openCount">
                0
            </div>

            <div class="stat-description">
                Waiting for action
            </div>

        </div>


        <div class="stat">

            <div class="stat-icon">
                🔴
            </div>

            <div class="stat-title">
                HIGH PRIORITY
            </div>

            <div
                class="stat-number"
                id="highCount">
                0
            </div>

            <div class="stat-description">
                Critical attention
            </div>

        </div>


        <div class="stat">

            <div class="stat-icon">
                🟢
            </div>

            <div class="stat-title">
                RESOLVED
            </div>

            <div
                class="stat-number"
                id="resolvedCount">
                0
            </div>

            <div class="stat-description">
                Successfully closed
            </div>

        </div>


        <div class="stat">

            <div class="stat-icon">
                🚨
            </div>

            <div class="stat-title">
                ESCALATED
            </div>

            <div
                class="stat-number"
                id="escalatedCount">
                0
            </div>

            <div class="stat-description">
                SLA exceeded
            </div>

        </div>

    </div>


    <!-- SUBMIT + RECENT -->

    <div class="grid-2">

        <!-- SUBMIT -->

        <div class="card">

            <h2>
                ➕ Submit Complaint
            </h2>

            <form id="complaintForm">

                <label>
                    Complaint Description
                </label>

                <textarea
                    id="complaintText"
                    placeholder="Example: There is a major water leak near the market..."
                    required>
                </textarea>


                <div class="form-row">

                    <div>

                        <label>
                            Category
                        </label>

                        <select id="category">

                            <option value="auto">
                                🤖 Auto Detect
                            </option>

                            <option value="water">
                                💧 Water
                            </option>

                            <option value="electricity">
                                ⚡ Electricity
                            </option>

                            <option value="road">
                                🛣️ Road
                            </option>

                            <option value="sanitation">
                                🗑️ Sanitation
                            </option>

                            <option value="other">
                                📌 Other
                            </option>

                        </select>

                    </div>


                    <div>

                        <label>
                            Urgency
                        </label>

                        <select id="urgency">

                            <option value="1">
                                1 — Low
                            </option>

                            <option value="2">
                                2 — Normal
                            </option>

                            <option value="3" selected>
                                3 — Medium
                            </option>

                            <option value="4">
                                4 — High
                            </option>

                            <option value="5">
                                5 — Critical
                            </option>

                        </select>

                    </div>

                </div>


                <label>
                    Location
                </label>

                <input
                    id="location"
                    placeholder="Street / area / landmark"
                    required>


                <label>
                    Citizen Name
                </label>

                <input
                    id="citizen"
                    placeholder="Your name">


                <label>
                    Contact Number
                </label>

                <input
                    id="phone"
                    placeholder="+91 XXXXX XXXXX">


                <label>
                    Evidence
                </label>

                <div class="file-box">

                    <input
                        id="evidence"
                        type="file"
                        accept="image/*">

                </div>


                <button
                    class="submit-btn"
                    type="submit">

                    🚀 Submit & Auto-Route Complaint

                </button>

            </form>

        </div>


        <!-- RECENT -->

        <div class="card">

            <div class="card-header">

                <h2>
                    🕒 Recent Activity
                </h2>

                <button
                    class="btn btn-light"
                    onclick="showPageByName('complaints')">

                    View All

                </button>

            </div>

            <div id="activityList"></div>

        </div>

    </div>

</section>


<!-- =====================================================
     COMPLAINTS
===================================================== -->

<section
    id="complaints"
    class="page">

    <div class="topbar">

        <div>

            <h1>
                Complaint Management
            </h1>

            <div class="subtitle">
                Search, filter and manage community complaints
            </div>

        </div>

        <button
            class="btn btn-primary"
            onclick="showPageByName('dashboard')">

            + New Complaint

        </button>

    </div>


    <div class="card">

        <div class="controls">

            <input
                id="search"
                class="search"
                placeholder="🔎 Search by ID, complaint, citizen, location..."
                oninput="renderTickets()">


            <select
                id="statusFilter"
                onchange="renderTickets()">

                <option value="all">
                    All Status
                </option>

                <option value="open">
                    Open
                </option>

                <option value="in-progress">
                    In Progress
                </option>

                <option value="resolved">
                    Resolved
                </option>

                <option value="escalated">
                    Escalated
                </option>

            </select>


            <select
                id="categoryFilter"
                onchange="renderTickets()">

                <option value="all">
                    All Categories
                </option>

                <option value="water">
                    Water
                </option>

                <option value="electricity">
                    Electricity
                </option>

                <option value="road">
                    Road
                </option>

                <option value="sanitation">
                    Sanitation
                </option>

                <option value="other">
                    Other
                </option>

            </select>


            <select
                id="priorityFilter"
                onchange="renderTickets()">

                <option value="all">
                    All Priority
                </option>

                <option value="high">
                    High
                </option>

                <option value="medium">
                    Medium
                </option>

                <option value="low">
                    Low
                </option>

            </select>

        </div>


        <div class="table-wrap">

            <table>

                <thead>

                    <tr>

                        <th>ID</th>
                        <th>Complaint</th>
                        <th>Category</th>
                        <th>Priority</th>
                        <th>Department</th>
                        <th>Status</th>
                        <th>SLA</th>
                        <th>Created</th>

                    </tr>

                </thead>

                <tbody id="ticketBody"></tbody>

            </table>

        </div>

    </div>

</section>


<!-- =====================================================
     MAP
===================================================== -->

<section
    id="map"
    class="page">

    <div class="topbar">

        <div>

            <h1>
                Complaint Map
            </h1>

            <div class="subtitle">
                Geographic view of reported civic issues
            </div>

        </div>

    </div>


    <div class="card">

        <div class="map" id="complaintMap">

            <div class="road"></div>

            <div class="road2"></div>

        </div>

        <div style="margin-top:15px;font-size:12px;color:#64748b">

            🔴 High Priority &nbsp;&nbsp;
            🟠 Medium Priority &nbsp;&nbsp;
            🟢 Low Priority

        </div>

    </div>

</section>


<!-- =====================================================
     ANALYTICS
===================================================== -->

<section
    id="analytics"
    class="page">

    <div class="topbar">

        <div>

            <h1>
                Analytics & Insights
            </h1>

            <div class="subtitle">
                Understand complaint patterns and department workload
            </div>

        </div>

    </div>


    <div class="grid-3">

        <div class="card">

            <h2>
                📊 Categories
            </h2>

            <div id="categoryAnalytics"></div>

        </div>


        <div class="card">

            <h2>
                🏢 Department Workload
            </h2>

            <div id="departmentAnalytics"></div>

        </div>


        <div class="card">

            <h2>
                ⚡ System Health
            </h2>

            <div class="department">

                <div class="department-top">

                    <span>
                        Routing Engine
                    </span>

                    <strong>
                        98%
                    </strong>

                </div>

                <div class="progress">

                    <div
                        class="progress-bar"
                        style="width:98%">
                    </div>

                </div>

            </div>


            <div class="department">

                <div class="department-top">

                    <span>
                        SLA Compliance
                    </span>

                    <strong id="slaRate">
                        0%
                    </strong>

                </div>

                <div class="progress">

                    <div
                        id="slaBar"
