/* =====================================================
   HELPERS
===================================================== */

function formatDate(date){

    return new Date(date)
    .toLocaleString(
        [],
        {
            dateStyle:"short",
            timeStyle:"short"
        }
    );

}


function timeAgo(date){

    const seconds =
    Math.floor(
        (
            new Date()
            -
            new Date(date)
        ) / 1000
    );


    if(seconds < 60)
        return "just now";


    const minutes =
    Math.floor(
        seconds / 60
    );


    if(minutes < 60)
        return minutes + " min ago";


    const hours =
    Math.floor(
        minutes / 60
    );


    if(hours < 24)
        return hours + " hr ago";


    return Math.floor(
        hours / 24
    ) + " days ago";

}


function escapeHTML(value){

    return String(value || "")
    .replace(
        /[&<>"']/g,
        character => ({

            "&":"&amp;",
            "<":"&lt;",
            ">":"&gt;",
            '"':"&quot;",
            "'":"&#039;"

        })[character]
    );

}


function showToast(message){

    const toast =
    document.getElementById(
        "toast"
    );


    toast.textContent =
    message;


    toast.style.display =
    "block";


    setTimeout(
        () => {

            toast.style.display =
            "none";

        },
        3000
    );

}


